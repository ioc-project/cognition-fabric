## Docker Compose Environment Configuration
DOCKER_DEFAULT_PLATFORM=linux/amd64

## Docker Image Tag (change this to deploy different branches: main, rebased-main, latest, etc.)
IMAGE_TAG=main

## Database Configuration
POSTGRES_DB=cfn_mgmt
POSTGRES_USER=postgresUser
POSTGRES_PASSWORD=postgresPW
POSTGRES_HOST=localhost
POSTGRES_PORT=5433  # Port for local connections (when DB runs in Docker)
POSTGRES_HOST_PORT=5433  # Host port (for connecting from local machine)
POSTGRES_CONTAINER_PORT=5432  # Container port (for inter-container communication)

## IOC Knowledge DB Configuration
IOC_KNOWLEDGE_DB=ioc-knowledge-db
IOC_KNOWLEDGE_DB_USER=postgresUser
IOC_KNOWLEDGE_DB_PASSWORD=postgresPW
IOC_KNOWLEDGE_DB_PORT=5456

# Database Debug (set to True to see SQL queries)
DB_ECHO=False

## IoC Scale CF Management Plane
# APP_NAME="IoC CFN Management Backend Service"
# IMAGE_NAME="ghcr.io/cisco-eti/ioc-scale-cf-mgmt-svc:latest"
# PORT=9000
# DEBUG=True
# LOG_LEVEL=INFO
ADMIN_USER_PASSWORD=admin
CFN_DEV_MODE=False

## Pagination Configuration (optional — default values are used if not set)
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

## IoC Scale CFN Service Configuration
CFN_NAME="My Cognition Fabric Node"
HEARTBEAT_INTERVAL_SECONDS=5
DB_NAME=cfn_cp
DB_SSL_MODE=disable

## IoC Scale CF Mgmt UI Service Configuration
NEXTAUTH_URL=http://localhost:9001
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXT_PUBLIC_CFN_UI_API_BASE_URL=http://localhost:9000

## IoC Scale CF Cognition Engine Configuration
