# Cognition Fabric environment template for all components.
# Copy to .env at the repository root and configure credentials before startup.
# Root tasks load this file and select service addresses/ports for each run mode.

## Shared development settings
DOCKER_DEFAULT_PLATFORM=linux/amd64
# Source Management and Go Demo CE bind to loopback by default. Native Linux
# mixed source/image setups can explicitly use 0.0.0.0.
LOCAL_CF_BIND_HOST=127.0.0.1
LOG_LEVEL=INFO

## Shared PostgreSQL
IOC_SCALE_DB_USER=postgresUser
IOC_SCALE_DB_PASSWORD=postgresPW
IOC_SCALE_DB_PORT=5456
# Management source/image tasks share this database. CFN uses cfn_audit_local.
# The tasks derive POSTGRES_* connection settings from these values.
LOCAL_CF_MGMT_DB=cfn_mgmt_local

## Management (cf-mgmt/)
ADMIN_USER_PASSWORD=admin
CFN_DEV_MODE=False
# Root tasks select the CFN URL for the chosen source/image mode.
CFN_SVC_URL=http://ioc-scale-cfn-svc:9002
# CE lifecycle monitoring thresholds
CE_MONITOR_CHECK_INTERVAL_SECONDS=1
CE_OFFLINE_THRESHOLD_SECONDS=3

## Cognition Fabric Node (cfn/)
CFN_NAME="My Cognition Fabric Node"
# Local tasks select Management/advertised addresses for the chosen run mode.
# CFN HTTP and gRPC listeners use ports 9002 and 9003.
MGMT_URL=http://ioc-scale-cf-mgmt-svc:9000
CFN_IP=Not Set
HEARTBEAT_INTERVAL_SECONDS=5
SERVICE_NAME=ioc-cfn-svc
# Legacy CE heartbeat interval (seconds)
CE_HEARTBEAT_INTERVAL_SEC=1

## Management UI (cf-ui/)
# Local tasks set the backend URL and publish the UI on port 9001.
NEXTAUTH_URL=http://localhost:9001
# Generate your own secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
# Source UI audit panel refresh interval in seconds while open. Set 0 to disable.
CFN_UI_AUDIT_REFRESH_INTERVAL_SECONDS=30
# Trace header flash duration after a new item arrives during auto-refresh. 0 disables.
CFN_UI_AUDIT_FLASH_DURATION_SECONDS=60

## Published CF images
# Optional :image counterparts of the local CF run tasks. Each task pulls its
# selected tag on every start; shell assignments override these defaults.
CF_REGISTRY=ghcr.io/cisco-eti
CF_MGMT_SVC_TAG=latest
CFN_SVC_TAG=latest
CF_UI_TAG=latest
CF_DEMO_CE_TAG=latest

## OXP (Observability & Explainability Platform) Stack
# Optional OXP/infrastructure tuning variables are in the infrastructure overrides
# section below; set them in root .env to override a default.

# LLM and embedding access for the OXP workers
# Two keys are read by different workers. When everything goes through one
# gateway, set both to the same value.
#   OPENAI_API_KEY     - mce and the other LLM workers
#   AI_GATEWAY_API_KEY - the embedding worker
# Without them those workers exit on startup and restart in a loop.
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Chat model, used by mce. Prefix with azure/ when the gateway routes to Azure.
LLM_MODEL_NAME=gpt-4o
LLM_BASE_MODEL_URL_MCE=https://api.openai.com/v1

# Gateway endpoint, used by embedding and the NOA sample.
# AI_GATEWAY_BASE_URL must be set when using a gateway: the worker otherwise
# falls back to https://api.openai.com/v1 and fails to connect.
AI_GATEWAY_BASE_URL=

# Example for a LiteLLM gateway:
#   OPENAI_API_KEY=<litellm key>
#   AI_GATEWAY_API_KEY=<same litellm key>
#   AI_GATEWAY_BASE_URL=https://<litellm host>
#   LLM_BASE_MODEL_URL_MCE=https://<litellm host>
#   LLM_MODEL_NAME=azure/gpt-4o
# The key needs both the chat and the embedding model on its allow-list.

# MLflow (model tracking; external to this stack)
MLFLOW_HOST=host.docker.internal
MLFLOW_PORT=5000

# Must match the OTel collector's database; Compose otherwise defaults to oxp.
CLICKHOUSE_DATABASE=default

# MCE also receives these through env_file; published image fallbacks are unverified.
NEO4J_PORT=7687
NEO4J_DATABASE=neo4j

# Queues wiring the pipeline
ANALYSIS_INPUT_QUEUE=new_session_to_analysis
MCE_INPUT_QUEUE=new_session_to_mce
MCE_OUTPUT_QUEUE=new_session_to_grouping
GROUPING_INPUT_QUEUE=new_session_to_grouping

## NOA trip planner (samples/noa-trip-planner/)
# Reuses AI_GATEWAY_BASE_URL and AI_GATEWAY_API_KEY from above, so the same
# gateway key needs the chat model on its allow-list. Published on 8125 because
# host 8000 is ioc-scale-cf-cognition-engine; this only moves the host port.
CLARIS_REGISTRY=ghcr.io/cisco-eti/claris/container-images
NOA_API_PORT=8125
NOA_LLM_MODEL=azure/gpt-4o
NOA_IMAGE_TAG=latest

# Simulated delays in the sample app, for stretching out a session so the
# pipeline has something slower to observe. Off unless the flag is true.
NOA_ENABLE_SIMULATED_DELAY=false
NOA_DELAY_SECONDS=0
NOA_DELAY_MODERATOR_SECONDS=1.5
NOA_DELAY_AGENT_SECONDS=3
NOA_DELAY_TOOL_SECONDS=2
NOA_DELAY_JITTER_SECONDS=0.5

# Recommended local proxy workflow: published native A2A agents and MCP.
# Infrastructure starts first; run:full-mas attaches the proxy after onboarding.
# Source NOA remains available with NOA_MODE=source / NOA_ENFORCEMENT_MODE=direct.
NOA_MODE=published
NOA_ENFORCEMENT_MODE=proxy
# Returned by onboarding mas/noa-a2a-mas.json through Management.
NOA_MAS_ID=
NOA_MCP_SERVER_ID=
# These custom images default to latest and are pulled on each explicit start.
NOA_A2A_TAG=latest
NOA_A2A_PLATFORM=linux/amd64
# Optional full image reference (including a digest) or custom canonical identity JSON.
NOA_A2A_IMAGE=
NOA_IDENTITY_FILE=
# Timeout used by the source NOA direct-enforcement adapter.
NOA_ENFORCEMENT_TIMEOUT_SEC=10

## Enforcement Proxy
# Proxy image architecture must match the Go plugin and Envoy image.
# Local A2A tasks use latest for sidecar/Wasm/controller/guard unless overridden.
# Optional local selectors: NOA_PROXY_SIDECAR_TAG, NOA_PROXY_WASM_TAG,
# NOA_PROXY_OPERATOR_TAG, NOA_PROXY_MCP_GUARD_TAG. Complete image overrides
# use upstream SIDECAR_IMAGE, TRACEPARENT_WASM_IMAGE, OPERATOR_DOCKER_IMAGE, MCP_GUARD_IMAGE.
ENFORCEMENT_PLATFORM=linux/arm64
ENVOY_HTTP_PORT=9010

## Template CE (samples/template-ce/)
# Forced verdict for the Python template CE; restart it after changing this value.
TEMPLATE_CE_DECISION=allow
# Optional registration name override; the template CE defaults to template-ce.
TEMPLATE_CE_NAME=

## Go Demo CE (samples/demo-ce/)
# JSON config path for source/image tasks, absolute or relative to this root.
# Copy samples/demo-ce/config/config.json and edit its MAS IDs/rules.
CE_CONFIG_FILE=.local/ce/config.json
# Optional registration name override; the demo CE defaults to demo-ce.
DEMO_CE_NAME=
# Only needed for the single-policy form: path to a file containing its MAS ID.
CE_MAS_FILE=

## Optional infrastructure overrides
# Shared stack settings for deploy/. Relative bind-mount paths resolve from deploy/.

## CF service images (GHCR). Registry and per-service tags; pin a tag to reproduce a specific build.
# The database is built from deploy/docker-db/ in this repo, so its tag is pinned rather than latest.
IOC_SCALE_DB_TAG=0.2.0
ENFORCEMENT_PROXY_MEDIATION_TAG=latest
# Optional full image@sha256 reference; wins over CF_REGISTRY and the tag.
# ENFORCEMENT_PROXY_MEDIATION_IMAGE=

## IOC Scale DB Configuration
IOC_SCALE_DB=ioc-scale-db
# Databases created on this server: cfn_mgmt, cognition_store, cfn_audit

## IoC Scale CF Management Plane
# CE health probing (seconds). CE_PROBE_TIMEOUT_SECONDS is used by both mgmt-svc and cfn-svc
CE_PROBE_INTERVAL_SECONDS=2
CE_PROBE_TIMEOUT_SECONDS=1

## Demo CE
# Config file mounted read-only; edit it with your MAS id and agent identities.
DEMO_CE_CONFIG_FILE=./demo-ce/config/config.json
# Evidence is selected per content rule in the JSON config.
DEMO_CE_LOG_FORMAT=console
# Set any non-empty value to disable console colors.
NO_COLOR=
CE_CONTEXT_WAIT=1s
CE_CONTEXT_ATTEMPTS=5
CE_CONTEXT_RETRY_WAIT=0.2s

## OXP (Observability & Explainability Platform) Stack
# Prebuilt OXP API and worker images (GHCR). Override tag to pin a version.
OXP_REGISTRY=ghcr.io/cisco-eti/oxp/container-images
OXP_IMG_TAG=latest
# oxp-api uses OXP_REGISTRY with its own tag (the API is versioned separately from the workers).
OXP_API_IMG_TAG=latest
# Full-image override for the API only. Leave empty to use OXP_REGISTRY/OXP_API_IMG_TAG.
OXP_API_IMAGE=
# Path to the MCE worker config mounted into the container
MCE_CONFIG_FILE=./mce_config.yaml

# Architecture for the OXP worker images (published for amd64 only).
CLARIS_WORKER_PLATFORM=linux/amd64
# Architecture for the OXP infrastructure containers: RabbitMQ, Neo4j,
# ClickHouse, and the OTel collector. These must run natively: RabbitMQ's Erlang
# runtime crashes during feature-flag setup under emulation. Set to linux/amd64
# on an Intel/AMD host.
OXP_INFRA_PLATFORM=linux/arm64

# RabbitMQ (message broker for OXP workers)
# Workers build the AMQP URL from these values; the host and port are set in
# deploy/docker-compose.yml and point at the bundled broker.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest # legit:ignore
# Grace period before the ClickHouse-to-RabbitMQ initializer begins polling.
OXP_INIT_DELAY_SECONDS=5
# Optional: point workers at an external broker instead of the bundled one.
# Takes precedence over the values above and the host/port in the compose file.
# RABBITMQ_URL=

# Embedding model and endpoint, used by the embedding worker.
# AI_GATEWAY_BASE_URL must be set when using a gateway: the worker otherwise
# falls back to https://api.openai.com/v1 and fails to connect.
EMBEDDING_MODEL=azure/text-embedding-3-small

# ClickHouse (raw telemetry store; bundled in this stack)
# The workers and the OTel collector both read these values. Point CLICKHOUSE_HOST
# at host.docker.internal to use an external instance instead of the bundled one.
CLICKHOUSE_HOST=clickhouse-server
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=admin
CLICKHOUSE_PASSWORD=admin # legit:ignore

# Neo4j
NEO4J_HOST=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=testpassword # legit:ignore

# oxp-api (former claris-api)
CACHE_REDIS_URL=redis://redis:6379/0
# Required for the NOA enforcement demo: a cached response returns a stale tool input.
CACHE_ENABLED=false
# Postgres credentials are read from IOC_SCALE_DB_* vars defined above
OXP_POSTGRES_DB=cognition_store

# Worker concurrency tuning (optional)
NORM_MAX_INFLIGHT_MESSAGES=64
EMBEDDING_MAX_INFLIGHT_MESSAGES=16
MCE_MAX_INFLIGHT_MESSAGES=16
GROUPING_MAX_INFLIGHT_MESSAGES=16
DECISION_BLOCK_MAX_INFLIGHT_MESSAGES=8
STATEFUL_EVAL_MAX_INFLIGHT_MESSAGES=8

# Analysis worker tuning
ANALYSIS_MAX_INFLIGHT_MESSAGES=3

HIERARCHICAL_GROUPING_MAX_INFLIGHT_MESSAGES=1

# Queues wiring the pipeline
EMBEDDING_OUTPUT_QUEUE=new_session_to_grouping,new_session_embedding_to_decision_block
DB_INPUT_QUEUE=new_session_embedding_to_decision_block
DB_NSEVAL_OUTPUT_Q=new_session_to_nseval
DB_STATEFUL_OUTPUT_Q=new_session_to_stateful_eval
STATEFUL_EVAL_INPUT_QUEUE=new_session_to_stateful_eval

# Optional analysis layer config files
ANOMALY_CONFIG_FILE=
CONSISTENCY_CONFIG_FILE=
NORMAL_BEHAVIOUR_CONFIG_FILE=

## Enforcement proxy mediation core (host ports are bound to 127.0.0.1)
# Chosen to avoid oxp-api (8081) and the enforcement proxy's own compose (8082, 18083).
BFF_GRPC_PORT=9006
BFF_HTTP_PORT=9005
# Local-development exception to mTLS; keep false anywhere else.
BFF_GRPC_ALLOW_INSECURE_LOCAL=true

## CFN gRPC connection (shared by mediation and enforcement adapters)
CF_ENFORCEMENT_ADDRESS=ioc-scale-cfn-svc:9003
CF_ENFORCEMENT_TIMEOUT=2s
CF_ENFORCEMENT_ALLOW_PLAINTEXT=true

## Enforcement flavors (optional, see deploy/enforcement/README.md)
# Start one with: make -C deploy up enforcement=envoy   or   make -C deploy up enforcement=shadi
# Published proxy images; explicit tags/full references allow rollback.
# Full references win over CF_REGISTRY and the corresponding tag.
# ENFORCEMENT_SIDECAR_TAG=latest
# ENFORCEMENT_WASM_TAG=latest
# ENFORCEMENT_SHADI_TAG=latest
# ENFORCEMENT_SIDECAR_IMAGE=
# ENFORCEMENT_WASM_IMAGE=
# ENFORCEMENT_SHADI_IMAGE=
# ENFORCEMENT_FAILURE_POSTURE=fail_closed
# Both adapters deliver audits directly to CFN; BFF_* configures mediation only.
# SHADi requires fail_closed and CF_ENFORCEMENT_TIMEOUT below 4s.
# AUDIT_QUEUE_CAPACITY=256
# AUDIT_RPC_TIMEOUT=2s
# MAX_MEDIATED_BODY_BYTES=1048576
# AUDIT_CAPTURE_MAX_BYTES=65536
# AUDIT_REDACT_PATTERNS=["(?i)token=[^&\\s]+"]
# Config inputs: the Envoy route spec and the SHADi verifier config directory.
# SIDECAR_SPEC=./enforcement/envoy/sidecar-spec.yaml
# ENVOY_BOOTSTRAP_TEMPLATE=./enforcement/envoy/envoy.yaml
# ENVOY_ACTIVATION_DIR=../.local/deploy-envoy/activation
# The default examples start unprovisioned; MAS attachment/activation is separate.
# SHADI_VERIFIER_CONFIG_DIR=./enforcement/shadi/config
# Host ports (127.0.0.1): Envoy inbound / outbound / admin, SHADi verifier.
# ENVOY_OUTBOUND_HTTP_PORT=9011
# ENVOY_ADMIN_PORT=9012
# SHADI_VERIFIER_PORT=9013
