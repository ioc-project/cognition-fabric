# CFN local stack template. Shared Compose defaults mirror ioc-scale-cf-deployment/.env.example.
# CFN-only source workflow settings are at the end of this file.
# Copy to .env and supply the gateway API keys before starting the stack.

## Docker Compose Environment Configuration
DOCKER_DEFAULT_PLATFORM=linux/amd64

## IOC Scale DB Configuration
IOC_SCALE_DB=ioc-scale-db
IOC_SCALE_DB_USER=postgresUser
IOC_SCALE_DB_PASSWORD=postgresPW
IOC_SCALE_DB_PORT=5456

## IoC Scale CF Management Plane
ADMIN_USER_PASSWORD=admin
CFN_DEV_MODE=False
LOG_LEVEL=INFO
CFN_SVC_URL=http://ioc-scale-cfn-svc:9002
# CE lifecycle monitoring thresholds
CE_MONITOR_CHECK_INTERVAL_SECONDS=1
CE_OFFLINE_THRESHOLD_SECONDS=3

## IoC Scale CFN Service Configuration
CFN_NAME="My Cognition Fabric Node"
MGMT_URL=http://ioc-scale-cf-mgmt-svc:9000
CFN_IP=Not Set
HEARTBEAT_INTERVAL_SECONDS=5
SERVICE_NAME=ioc-cfn-svc

# Demo CE heartbeat interval (seconds)
CE_HEARTBEAT_INTERVAL_SEC=1

## IoC Scale CF Mgmt UI Service Configuration
NEXTAUTH_URL=http://localhost:9001
NEXTAUTH_SECRET=your_nextauth_secret_here

## OXP (Observability & Explainability Platform) Stack
# Prebuilt OXP API and worker images (GHCR). Override tag to pin a version.
OXP_REGISTRY=ghcr.io/cisco-eti/oxp/container-images
OXP_IMG_TAG=latest
# Optional override for the OXP API image pinned in docker-compose.yml.
OXP_API_IMAGE=
# Path to the MCE worker config mounted into the container
MCE_CONFIG_FILE=./mce_config.yaml

# Architecture for the OXP worker images (published for amd64 only).
CLARIS_WORKER_PLATFORM=linux/amd64
# Architecture for the OXP infrastructure containers: RabbitMQ, Neo4j,
# ClickHouse, and the OTel collector. These must run natively: RabbitMQ's Erlang
# runtime crashes during feature-flag setup under emulation. Set to linux/amd64
# on an Intel/AMD host.
OXP_INFRA_PLATFORM=linux/arm64

# RabbitMQ (message broker for OXP workers)
# Workers build the AMQP URL from these values; the host and port are set in
# docker-compose.yml and point at the bundled broker.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest # legit:ignore
# Grace period before the ClickHouse-to-RabbitMQ initializer begins polling.
OXP_INIT_DELAY_SECONDS=5
# Optional: point workers at an external broker instead of the bundled one.
# Takes precedence over the values above and the host/port in the compose file.
# RABBITMQ_URL=

# LLM and embedding access for the OXP workers
# Two keys are read by different workers. When everything goes through one
# gateway, set both to the same value.
#   OPENAI_API_KEY     - mce and the other LLM workers
#   AI_GATEWAY_API_KEY - the embedding worker
# Without them those workers exit on startup and restart in a loop.
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Chat model, used by mce. Prefix with azure/ when the gateway routes to Azure.
LLM_MODEL_NAME=gpt-4o
LLM_BASE_MODEL_URL_MCE=https://api.openai.com/v1

# Embedding model and endpoint, used by the embedding worker.
# AI_GATEWAY_BASE_URL must be set when using a gateway: the worker otherwise
# falls back to https://api.openai.com/v1 and fails to connect.
EMBEDDING_MODEL=azure/text-embedding-3-small
AI_GATEWAY_BASE_URL=

# Example for a LiteLLM gateway:
#   OPENAI_API_KEY=<litellm key>
#   AI_GATEWAY_API_KEY=<same litellm key>
#   AI_GATEWAY_BASE_URL=https://<litellm host>
#   LLM_BASE_MODEL_URL_MCE=https://<litellm host>
#   LLM_MODEL_NAME=azure/gpt-4o
# The key needs both the chat and the embedding model on its allow-list.

# MLflow (model tracking; external to this stack)
MLFLOW_HOST=host.docker.internal
MLFLOW_PORT=5000

# ClickHouse (raw telemetry store; bundled in this stack)
# The workers and the OTel collector both read these values. Point CLICKHOUSE_HOST
# at host.docker.internal to use an external instance instead of the bundled one.
CLICKHOUSE_HOST=clickhouse-server
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=admin
CLICKHOUSE_PASSWORD=admin # legit:ignore
CLICKHOUSE_DATABASE=default

# Neo4j
NEO4J_HOST=neo4j
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_PASSWORD=testpassword # legit:ignore

# oxp-api (former claris-api)
CACHE_REDIS_URL=redis://redis:6379/0
# Postgres credentials are read from IOC_SCALE_DB_* vars defined above
OXP_POSTGRES_DB=cognition_store

# Worker concurrency tuning (optional)
NORM_MAX_INFLIGHT_MESSAGES=64
EMBEDDING_MAX_INFLIGHT_MESSAGES=16
MCE_MAX_INFLIGHT_MESSAGES=16
GROUPING_MAX_INFLIGHT_MESSAGES=16
DECISION_BLOCK_MAX_INFLIGHT_MESSAGES=8
STATEFUL_EVAL_MAX_INFLIGHT_MESSAGES=8

# Analysis worker tuning
ANALYSIS_MAX_INFLIGHT_MESSAGES=3

HIERARCHICAL_GROUPING_MAX_INFLIGHT_MESSAGES=1

# Queues wiring the pipeline
ANALYSIS_INPUT_QUEUE=new_session_to_analysis
MCE_INPUT_QUEUE=new_session_to_mce
MCE_OUTPUT_QUEUE=new_session_to_grouping
GROUPING_INPUT_QUEUE=new_session_to_grouping
EMBEDDING_OUTPUT_QUEUE=new_session_to_grouping,new_session_embedding_to_decision_block
DB_INPUT_QUEUE=new_session_embedding_to_decision_block
DB_NSEVAL_OUTPUT_Q=new_session_to_nseval
DB_STATEFUL_OUTPUT_Q=new_session_to_stateful_eval
STATEFUL_EVAL_INPUT_QUEUE=new_session_to_stateful_eval

# Optional analysis layer config files
ANOMALY_CONFIG_FILE=
CONSISTENCY_CONFIG_FILE=
NORMAL_BEHAVIOUR_CONFIG_FILE=

# NOA trip planner (MAS sample app; bundled in this stack)
# Reuses AI_GATEWAY_BASE_URL and AI_GATEWAY_API_KEY from above, so the same
# gateway key needs the chat model on its allow-list. Published on 8125 because
# host 8000 is ioc-scale-cf-cognition-engine; this only moves the host port.
CLARIS_REGISTRY=ghcr.io/cisco-eti/claris/container-images
NOA_API_PORT=8125
NOA_LLM_MODEL=azure/gpt-4o
NOA_IMAGE_TAG=latest

# Simulated delays in the sample app, for stretching out a session so the
# pipeline has something slower to observe. Off unless the flag is true.
NOA_ENABLE_SIMULATED_DELAY=false
NOA_DELAY_SECONDS=0
NOA_DELAY_MODERATOR_SECONDS=1.5
NOA_DELAY_AGENT_SECONDS=3
NOA_DELAY_TOOL_SECONDS=2
NOA_DELAY_JITTER_SECONDS=0.5

# CFN local workflow: task infra:up and task run:full-mas read both settings.
# NOA_MODE: published (default) or source. Proxy mode requires source.
NOA_MODE=published
# direct retains the application-side CFN call; proxy sends tool HTTP requests through Envoy.
NOA_ENFORCEMENT_MODE=direct
# Optional proxy client origin; empty uses http://127.0.0.1:${ENVOY_HTTP_PORT:-9010}.
NOA_ENFORCEMENT_PROXY_URL=
# Host tool service managed automatically by the source NOA task in proxy mode.
# Docker Desktop reaches the host listener; a generated token restricts execution to Envoy.
NOA_TOOLS_HOST=0.0.0.0
NOA_TOOLS_PORT=8126
# Proxy image architecture must match the Go plugin and Envoy image.
ENFORCEMENT_PLATFORM=linux/arm64
ENVOY_HTTP_PORT=9010
# Set this to the MAS ID created in the local management UI.
NOA_MAS_ID=
NOA_ENFORCEMENT_TIMEOUT_SEC=10

# Forced verdict for the source demo CE; restart it after changing this value.
DEMO_CE_DECISION=allow

# Policy CE source task: JSON policy path, absolute or relative to the CFN checkout.
# Copy ../ioc-scale-cf-demo-ce/policy-ce/config/policy.json and edit its MAS IDs/rules.
CE_POLICY_FILE=tmp/policy.json
# Only needed for the single-policy form: path to a file containing its MAS ID.
CE_MAS_FILE=
