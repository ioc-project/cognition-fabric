## Database Configuration (required for local development)
POSTGRES_DB=cfn_mgmt
POSTGRES_USER=postgresUser
POSTGRES_PASSWORD=postgresPW
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Migration-only interpretation of legacy naive database-session wall times.
# New storage/API timestamps always use UTC. See docs/DATABASE_MIGRATIONS.md.
LEGACY_TIMESTAMP_TZ=UTC

## Application Configuration
# SERVICE_NAME=ioc-scale-cf-mgmt-svc
# APPLICATION_VERSION=dev
# PORT=9000
LOG_LEVEL=INFO
ADMIN_USER_PASSWORD=admin
CFN_DEV_MODE=False
