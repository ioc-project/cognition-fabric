## Database Configuration
POSTGRES_DB=cfn_mgmt
POSTGRES_USER=postgresUser
POSTGRES_PASSWORD=postgresPW
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Database Debug (set to True to see SQL queries)
DB_ECHO=False

## Application Configuration
# SERVICE_NAME=ioc-scale-cf-mgmt-svc
# APPLICATION_VERSION=dev
# PORT=9000
LOG_LEVEL=INFO
ADMIN_USER_PASSWORD=admin
CFN_DEV_MODE=False

## Memory Provider Encryption Key
# Auto-generated in .secrets/encryption.key on first run (works for local dev).
# For production: set MEMORY_PROVIDER_ENCRYPTION_KEY env var to override.
# Generate key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MEMORY_PROVIDER_ENCRYPTION_KEY=your-key-here

## JWT Configuration
# JWT_SECRET_KEY=your-secret-key-change-in-production

## Pagination Configuration (optional — default values are used if not set)
# DEFAULT_PAGE_SIZE=20
# MAX_PAGE_SIZE=100

## CFN Service URL (for proxying requests to the data plane)
# CFN_SVC_URL=http://localhost:9002
