CFN_UI_API_BASE_URL=http://localhost:9000

# Audit panel refresh interval in seconds while open. Set 0 to disable.
CFN_UI_AUDIT_REFRESH_INTERVAL_SECONDS=30
# Trace header flash duration after a new item arrives during auto-refresh. 0 disables.
CFN_UI_AUDIT_FLASH_DURATION_SECONDS=60

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:9001
# Generate your own with: `openssl rand -base64 32`
NEXTAUTH_SECRET=secret
